[Desktop Entry]
Type=Application
Version=1.0
Name=SD-ON RADIO — установка и удаление
Name[ru]=SD-ON RADIO — установка и удаление
Comment=Установить, обновить или удалить SD-ON RADIO
Comment[ru]=Установить, обновить или удалить SD-ON RADIO
Exec=bash -c "self=\"\$1\"; case \"\$self\" in file://*) self=\"\${self#file://}\" ;; esac; if [ ! -f \"\$self\" ]; then command -v kdialog >/dev/null 2>&1 && kdialog --error \"Не удалось открыть установщик.\"; exit 1; fi; script=\"\$(mktemp --suffix=-sd-on-radio-installer.sh)\"; trap 'rm -f \"\$script\"' EXIT HUP INT TERM; sed -n '/^# __SD_ON_RADIO_INSTALLER__\$/,\$p' \"\$self\" | sed '1d; s/^# //' | base64 -d > \"\$script\" || { command -v kdialog >/dev/null 2>&1 && kdialog --error \"Установщик повреждён.\"; exit 1; }; actual=\"\$(sha256sum \"\$script\" | awk '{ print \$1 }')\"; if [ \"\$actual\" != \"__INSTALLER_SHA256__\" ]; then command -v kdialog >/dev/null 2>&1 && kdialog --error \"Установщик повреждён.\"; exit 1; fi; chmod +x \"\$script\"; sh \"\$script\"; result=\$?; rm -f \"\$script\"; trap - EXIT HUP INT TERM; exit \"\$result\"" _ %k
Icon=system-software-install
Terminal=false
Categories=Audio;AudioVideo;Player;
Keywords=radio;steamdeck;install;uninstall;
StartupNotify=true
# __SD_ON_RADIO_INSTALLER__
